include_guard(GLOBAL)

# Preserve list values and paths verbatim in the child build's initial cache.
function(mcuhw_write_initial_cache output)
    set(content "# Generated from the parent compiler configuration.\n")
    foreach(name IN LISTS ARGN)
        if(DEFINED ${name})
            set(delimiter "==")
            while("${${name}}" MATCHES "\\]${delimiter}\\]")
                string(APPEND delimiter "=")
            endwhile()
            string(APPEND content "set(${name} [${delimiter}[${${name}}]${delimiter}] CACHE STRING \"\" FORCE)\n")
        endif()
    endforeach()
    file(CONFIGURE OUTPUT "${output}" CONTENT "${content}" @ONLY)
endfunction()

# SDK initialization owns its response files. Inject parent base flags after
# compiler setup and before component directories are created so Ninja sees
# changed flags and old parent values do not persist in SDK response files.
function(mcuhw_prepare_sdk_flags output hook)
    set(parent_flags [=[
foreach(variable IN ITEMS CMAKE_C_FLAGS CMAKE_CXX_FLAGS CMAKE_ASM_FLAGS CMAKE_EXE_LINKER_FLAGS)
    if(DEFINED MCUHW_PARENT_${variable})
        string(APPEND ${variable} " ${MCUHW_PARENT_${variable}}")
    endif()
endforeach()
]=])
    set(CMAKE_PROJECT_INCLUDE "${hook}")
    file(CONFIGURE OUTPUT "${hook}" CONTENT "${parent_flags}" @ONLY)
    set(forward CMAKE_PROJECT_INCLUDE)
    get_cmake_property(cache_variables CACHE_VARIABLES)
    foreach(variable IN LISTS cache_variables)
        if(variable MATCHES "^CMAKE_(C|CXX|ASM|EXE_LINKER)_FLAGS(_[A-Z0-9_]+)?$")
            if(variable MATCHES "^CMAKE_(C|CXX|ASM|EXE_LINKER)_FLAGS$")
                set(MCUHW_PARENT_${variable} "${${variable}}" PARENT_SCOPE)
                list(APPEND forward "MCUHW_PARENT_${variable}")
            else()
                list(APPEND forward "${variable}")
            endif()
        endif()
    endforeach()
    set(CMAKE_PROJECT_INCLUDE "${hook}" PARENT_SCOPE)
    set(${output} "${forward}" PARENT_SCOPE)
endfunction()
