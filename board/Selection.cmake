# Resolve one board from its local CMake entry.
include_guard(GLOBAL)

function(mcuhw_resolve_board)
    if(NOT MCUHW_ROOT)
        get_filename_component(MCUHW_ROOT "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/.." ABSOLUTE)
    endif()
    set(MCUHW_ROOT "${MCUHW_ROOT}" CACHE PATH "mcuhw source or installed resource root")
    if(NOT MCUHW_BOARD MATCHES "^[a-z0-9][a-z0-9_-]*/[a-z0-9][a-z0-9_.-]*$")
        message(FATAL_ERROR "Set MCUHW_BOARD to an exact vendor/name ID (for example arduino/uno_r4_minima).")
    endif()
    set(entry "${MCUHW_ROOT}/board/${MCUHW_BOARD}/board.cmake")
    if(NOT EXISTS "${entry}")
        message(FATAL_ERROR "Unknown mcuhw board '${MCUHW_BOARD}': ${entry} does not exist.")
    endif()
    include("${entry}")
    if(NOT MCUHW_BOARD_REVISION)
        set(MCUHW_BOARD_REVISION "${MCUHW_BOARD_DEFAULT_REVISION}")
    endif()
    if(NOT MCUHW_BOARD_REVISION IN_LIST MCUHW_BOARD_REVISIONS)
        message(FATAL_ERROR "Unsupported revision '${MCUHW_BOARD_REVISION}' for ${MCUHW_BOARD}; supported: ${MCUHW_BOARD_REVISIONS}.")
    endif()
    set(selection "${MCUHW_BOARD}@${MCUHW_BOARD_REVISION}")
    if(NOT _mcuhw_workspace_board)
        if(DEFINED MCUHW_CONFIGURED_BOARD AND NOT MCUHW_CONFIGURED_BOARD STREQUAL selection)
            message(FATAL_ERROR "This build directory belongs to ${MCUHW_CONFIGURED_BOARD}. Use a separate build directory for ${selection}.")
        endif()
        set(MCUHW_CONFIGURED_BOARD "${selection}" CACHE INTERNAL "Immutable board selection")
        set(MCUHW_BOARD "${MCUHW_BOARD}" CACHE STRING "Selected board vendor/name")
        set(MCUHW_BOARD_REVISION "${MCUHW_BOARD_REVISION}" CACHE STRING "Selected board revision")
    endif()
    foreach(field IN ITEMS TOOLCHAIN PROFILE_HEADER)
        if(NOT EXISTS "${MCUHW_ROOT}/${MCUHW_BOARD_${field}}")
            message(FATAL_ERROR "Missing ${field} for ${MCUHW_BOARD}: ${MCUHW_BOARD_${field}}")
        endif()
    endforeach()
    string(REGEX REPLACE "^include/" "" profile_header "${MCUHW_BOARD_PROFILE_HEADER}")
    set(MCUHW_BOARD_ENTRY "${entry}" PARENT_SCOPE)
    set(MCUHW_BOARD_TOOLCHAIN "${MCUHW_ROOT}/${MCUHW_BOARD_TOOLCHAIN}" PARENT_SCOPE)
    set(MCUHW_BOARD_ARCHITECTURE "${MCUHW_BOARD_ARCHITECTURE}" PARENT_SCOPE)
    set(MCUHW_BOARD_PROFILE_HEADER "${profile_header}" PARENT_SCOPE)
    set(MCUHW_BOARD_PROFILE "${MCUHW_BOARD_PROFILE_TYPE}" PARENT_SCOPE)
    set(MCUHW_BOARD_EXAMPLES "${MCUHW_BOARD_EXAMPLES}" PARENT_SCOPE)
    set(MCUHW_BOARD_TEST_PROJECT "${MCUHW_BOARD_TEST_PROJECT}" PARENT_SCOPE)
    set(MCUHW_BOARD_REVISION "${MCUHW_BOARD_REVISION}" PARENT_SCOPE)
endfunction()
