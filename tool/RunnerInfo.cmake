# @req REQ-0049 REQ-0050
include("${BOARD_ENTRY}")
if(NOT MCUBSP_BOARD_RUNNER)
    message(FATAL_ERROR "Selected board does not declare MCUBSP_BOARD_RUNNER")
endif()
set(info "{}")
string(JSON info SET "${info}" runner "${MCUBSP_BOARD_RUNNER}")
string(JSON info SET "${info}" default_revision "\"${MCUBSP_BOARD_DEFAULT_REVISION}\"")
set(revisions "[]")
set(index 0)
foreach(revision IN LISTS MCUBSP_BOARD_REVISIONS)
    string(JSON revisions SET "${revisions}" ${index} "\"${revision}\"")
    math(EXPR index "${index} + 1")
endforeach()
string(JSON info SET "${info}" revisions "${revisions}")
file(WRITE "${OUTPUT}" "${info}\n")
