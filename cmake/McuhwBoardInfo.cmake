# Read build settings from one board's local CMake entry for host tools.
if(NOT MCUHW_ROOT OR NOT MCUHW_BOARD OR NOT MCUHW_BOARD_INFO_OUTPUT)
    message(FATAL_ERROR "MCUHW_ROOT, MCUHW_BOARD and MCUHW_BOARD_INFO_OUTPUT are required")
endif()
if(NOT MCUHW_BOARD MATCHES "^[a-z0-9][a-z0-9_-]*/[a-z0-9][a-z0-9_.-]*$")
    message(FATAL_ERROR "Invalid board ID: ${MCUHW_BOARD}")
endif()
set(entry "${MCUHW_ROOT}/board/${MCUHW_BOARD}/board.cmake")
if(NOT EXISTS "${entry}")
    message(FATAL_ERROR "Unknown mcuhw board '${MCUHW_BOARD}'")
endif()
include("${entry}")
set(result "{}")
foreach(field IN ITEMS id default_revision architecture)
    if(field STREQUAL "id")
        set(value "${MCUHW_BOARD}")
    else()
        string(TOUPPER "${field}" upper)
        set(value "${MCUHW_BOARD_${upper}}")
    endif()
    string(JSON result SET "${result}" "${field}" "\"${value}\"")
endforeach()
foreach(field IN ITEMS revisions examples tools)
    string(TOUPPER "${field}" upper)
    set(array "[]")
    set(index 0)
    foreach(value IN LISTS MCUHW_BOARD_${upper})
        string(JSON array SET "${array}" ${index} "\"${value}\"")
        math(EXPR index "${index} + 1")
    endforeach()
    string(JSON result SET "${result}" "${field}" "${array}")
    if(field STREQUAL "tools")
        set(build_tools "${array}")
    endif()
endforeach()
set(build "{}")
string(JSON build SET "${build}" "tools" "${build_tools}")
string(JSON build SET "${build}" "runner" "${MCUHW_BOARD_RUNNER}")
string(JSON result SET "${result}" "build" "${build}")
file(WRITE "${MCUHW_BOARD_INFO_OUTPUT}" "${result}\n")
