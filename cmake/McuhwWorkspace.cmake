include_guard(GLOBAL)
include("${CMAKE_CURRENT_LIST_DIR}/McuhwEspIdfEnvironment.cmake")

# Active boards are a workspace preference, not a repository-wide registry.
# @req REQ-0047 REQ-0048 REQ-0049 REQ-0052

# Preserve list values and paths verbatim in the child build's initial cache.
function(_mcuhw_workspace_cache output)
    set(content "# Generated from the active architecture workspace.\n")
    foreach(name IN LISTS ARGN)
        if(DEFINED ${name})
            set(delimiter "==")
            while("${${name}}" MATCHES "\\]${delimiter}\\]")
                string(APPEND delimiter "=")
            endwhile()
            string(APPEND content "set(${name} [${delimiter}[${${name}}]${delimiter}] CACHE STRING \"\" FORCE)\n")
        endif()
    endforeach()
    file(CONFIGURE OUTPUT "${output}" CONTENT "${content}" @ONLY)
endfunction()

# Instrumented tests have their own dependency graph and are configured only
# when explicitly built. Their support libraries never enter the example menu.
function(_mcuhw_workspace_tests prefix binary json)
    set(test_rules "${MCUHW_ROOT}/board/${MCUHW_BOARD}/tests.cmake")
    string(JSON test_project ERROR_VARIABLE no_project GET "${json}" build test_project)
    if(NOT EXISTS "${test_rules}" AND no_project)
        return()
    endif()
    set(seed "${binary}/tests-cache.cmake")
    set(forward CMAKE_BUILD_TYPE CMAKE_MAKE_PROGRAM
        MCUHW_MCUTEST_SOURCE_DIR MCUHW_MCUJSON_SOURCE_DIR MCUHW_MCUCOV_SOURCE_DIR
        MCUHW_MCUIP_SOURCE_DIR mcucov_DIR Python3_EXECUTABLE)
    if(EXISTS "${test_rules}")
        set(MCUHW_WORKSPACE OFF)
        set(MCUHW_ACTIVE_BOARDS "")
        set(MCUHW_EXAMPLE "")
        set(MCUHW_BOARD_TESTS "${MCUHW_BOARD}")
        foreach(flag IN ITEMS BUILD_TESTS BUILD_PROBES CHECK_HEADERS BUILD_MCUIP_CONTRACTS
                BUILD_TOOLING_TESTS BUILD_IO_EXAMPLES BUILD_IO_COST_REPORT INSTALL)
            set(MCUHW_${flag} OFF)
            list(APPEND forward MCUHW_${flag})
        endforeach()
        _mcuhw_workspace_cache("${seed}" ${forward} CMAKE_TOOLCHAIN_FILE
            MCUHW_ARM_CXX_COMPILER MCUHW_ESP32P4_CXX_COMPILER MCUHW_BOARD_REVISION
            MCUHW_WORKSPACE MCUHW_ACTIVE_BOARDS MCUHW_EXAMPLE MCUHW_BOARD_TESTS)
        set(source "${MCUHW_ROOT}")
        set(build_args --target board-tests)
        set(environment "")
    else()
        if(IS_ABSOLUTE "${test_project}" OR test_project MATCHES "(^|/)\\.\\.(/|$)" OR
                NOT EXISTS "${MCUHW_ROOT}/${test_project}/CMakeLists.txt")
            message(FATAL_ERROR "Invalid build.test_project for ${MCUHW_BOARD}: ${test_project}")
        endif()
        # SDK test projects use their own toolchain and ordinary SDK entry point.
        mcuhw_idf_environment(environment)
        set(source "${MCUHW_ROOT}/${test_project}")
        set(SDKCONFIG "${binary}/tests/sdkconfig")
        set(SDKCONFIG_DEFAULTS "${source}/sdkconfig.defaults")
        set(IDF_TARGET "${MCUHW_IDF_TARGET}")
        _mcuhw_workspace_cache("${seed}" ${forward} PYTHON IDF_TARGET SDKCONFIG SDKCONFIG_DEFAULTS)
        set(build_args "")
    endif()
    add_custom_target(${prefix}.tests
        COMMAND ${environment} "${CMAKE_COMMAND}" -S "${source}" -B "${binary}/tests"
            -G "${CMAKE_GENERATOR}" -C "${seed}"
        COMMAND ${environment} "${CMAKE_COMMAND}" --build "${binary}/tests"
            --config "$<CONFIG>" ${build_args}
        USES_TERMINAL VERBATIM)
    set_target_properties(${prefix}.tests PROPERTIES FOLDER "Boards/${MCUHW_BOARD}")
endfunction()

function(_mcuhw_workspace_board selection)
    if(NOT selection MATCHES "^([a-z0-9][a-z0-9_-]*/[a-z0-9][a-z0-9_.-]*)(@([a-z0-9][a-z0-9_.-]*))?$")
        message(FATAL_ERROR "Invalid active board '${selection}'; use vendor/board[@revision].")
    endif()
    set(MCUHW_BOARD "${CMAKE_MATCH_1}")
    set(MCUHW_BOARD_REVISION "${CMAKE_MATCH_3}")
    set(_mcuhw_workspace_board TRUE)
    mcuhw_resolve_board()
    file(READ "${MCUHW_BOARD_MANIFEST}" json)
    string(JSON architecture ERROR_VARIABLE no_arch GET "${json}" build architecture)
    if(no_arch OR NOT architecture STREQUAL MCUHW_ARCH)
        message(FATAL_ERROR "Active board ${MCUHW_BOARD} requires architecture '${architecture}', but this workspace uses '${MCUHW_ARCH}'. Select the matching configure preset or remove this board from MCUHW_ACTIVE_BOARDS.")
    endif()
    # Full vendor-qualified names stay stable as the active set changes.
    string(REPLACE "/" "." prefix "${MCUHW_BOARD}")
    get_property(registered GLOBAL PROPERTY MCUHW_WORKSPACE_BOARD_PREFIXES)
    if(prefix IN_LIST registered)
        message(FATAL_ERROR "Active board ${MCUHW_BOARD} is listed more than once. Use one revision per board in a workspace.")
    endif()
    set_property(GLOBAL APPEND PROPERTY MCUHW_WORKSPACE_BOARD_PREFIXES "${prefix}")
    set(binary "${CMAKE_BINARY_DIR}/boards/${MCUHW_BOARD}/${MCUHW_BOARD_REVISION}")
    set(MCUHW_STARTUP supplied)
    string(JSON count LENGTH "${json}" examples)
    if(count GREATER 0)
        add_custom_target(${prefix}.examples)
        set_target_properties(${prefix}.examples PROPERTIES FOLDER "Boards/${MCUHW_BOARD}")
        add_dependencies(examples ${prefix}.examples)
        math(EXPR last "${count} - 1")
        foreach(index RANGE 0 ${last})
            string(JSON entry GET "${json}" examples ${index})
            if(NOT entry MATCHES "^examples/([a-zA-Z0-9_.-]+/)*[a-zA-Z0-9_.-]+/CMakeLists\\.txt$" OR
                    entry MATCHES "(^|/)\\.\\.(/|$)" OR NOT EXISTS "${MCUHW_ROOT}/${entry}")
                message(FATAL_ERROR "Invalid example entry '${entry}' for ${MCUHW_BOARD}; expected an existing examples/.../CMakeLists.txt.")
            endif()
            get_filename_component(directory "${MCUHW_ROOT}/${entry}" DIRECTORY)
            get_filename_component(example "${directory}" NAME)
            set(MCUHW_FIRMWARE_TARGET "${prefix}.examples.${example}")
            if(TARGET ${MCUHW_FIRMWARE_TARGET})
                message(FATAL_ERROR "Duplicate workspace example target ${MCUHW_FIRMWARE_TARGET}")
            endif()
            add_subdirectory("${directory}" "${binary}/examples/${example}" EXCLUDE_FROM_ALL)
            if(NOT TARGET ${MCUHW_FIRMWARE_TARGET})
                message(FATAL_ERROR "${entry} must create the requested MCUHW_FIRMWARE_TARGET (${MCUHW_FIRMWARE_TARGET}).")
            endif()
            set_target_properties(${MCUHW_FIRMWARE_TARGET} PROPERTIES
                FOLDER "Boards/${MCUHW_BOARD}/Examples")
            add_dependencies(${prefix}.examples ${MCUHW_FIRMWARE_TARGET})
        endforeach()
    endif()
    _mcuhw_workspace_tests("${prefix}" "${binary}" "${json}")
endfunction()

function(mcuhw_add_active_boards)
    if(NOT CMAKE_CROSSCOMPILING)
        message(FATAL_ERROR "An active-board workspace requires a cross-architecture configure preset.")
    endif()
    get_filename_component(compiler "${CMAKE_CXX_COMPILER}" REALPATH)
    set(identity "${MCUHW_ARCH}|${compiler}")
    if(DEFINED MCUHW_WORKSPACE_IDENTITY AND NOT MCUHW_WORKSPACE_IDENTITY STREQUAL identity)
        message(FATAL_ERROR "This workspace uses ${MCUHW_WORKSPACE_IDENTITY}; select a separate build directory for ${identity}.")
    endif()
    set(MCUHW_WORKSPACE_IDENTITY "${identity}" CACHE INTERNAL "Workspace architecture/compiler")
    if(NOT MCUHW_ROOT)
        get_filename_component(MCUHW_ROOT "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/.." ABSOLUTE)
    endif()
    set(active "${MCUHW_ACTIVE_BOARDS}")
    # Only an explicit exhaustive request scans the board catalog.
    if(active STREQUAL "all")
        set(active "")
        file(GLOB manifests CONFIGURE_DEPENDS "${MCUHW_ROOT}/board/*/*/component.json")
        foreach(manifest IN LISTS manifests)
            file(READ "${manifest}" json)
            set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${manifest}")
            string(JSON architecture ERROR_VARIABLE no_arch GET "${json}" build architecture)
            if(NOT no_arch AND architecture STREQUAL MCUHW_ARCH)
                string(JSON board GET "${json}" id)
                list(APPEND active "${board}")
            endif()
        endforeach()
    endif()
    add_custom_target(examples)
    set_target_properties(examples PROPERTIES FOLDER "Workspace")
    foreach(selection IN LISTS active)
        _mcuhw_workspace_board("${selection}")
    endforeach()
    if(NOT active)
        message(STATUS "No active boards. Set MCUHW_ACTIVE_BOARDS to vendor/board IDs separated by semicolons, then reconfigure.")
    else()
        message(STATUS "Active boards (${MCUHW_ARCH}): ${active}")
    endif()
endfunction()
