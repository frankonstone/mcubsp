include_guard(GLOBAL)
include("${CMAKE_CURRENT_LIST_DIR}/McuhwEspIdfEnvironment.cmake")

# Active boards are a workspace preference, not a repository-wide registry.
# @req REQ-0047 REQ-0048 REQ-0049 REQ-0052

include("${CMAKE_CURRENT_LIST_DIR}/McuhwCache.cmake")

# Instrumented tests have their own dependency graph and are configured only
# when explicitly built. Their support libraries never enter the example menu.
function(_mcuhw_workspace_tests prefix binary)
    set(test_target "${prefix}.tests")
    if(ARGC GREATER 2)
        set(test_target "${ARGV2}")
    endif()
    set(test_rules "${MCUHW_ROOT}/board/${MCUHW_BOARD}/tests.cmake")
    set(test_project "${MCUHW_BOARD_TEST_PROJECT}")
    if(NOT EXISTS "${test_rules}" AND NOT test_project)
        return()
    endif()
    set(seed "${binary}/tests-cache.cmake")
    set(forward CMAKE_BUILD_TYPE CMAKE_MAKE_PROGRAM
        CMAKE_C_FLAGS CMAKE_CXX_FLAGS CMAKE_ASM_FLAGS CMAKE_EXE_LINKER_FLAGS
        MCUHW_MCUTEST_SOURCE_DIR MCUHW_MCUJSON_SOURCE_DIR MCUHW_MCUCOV_SOURCE_DIR
        MCUHW_MCUIP_SOURCE_DIR mcucov_DIR Python3_EXECUTABLE)
    get_cmake_property(cache_variables CACHE_VARIABLES)
    foreach(variable IN LISTS cache_variables)
        if(variable MATCHES "^CMAKE_(C|CXX|ASM|EXE_LINKER)_FLAGS(_[A-Z0-9_]+)?$")
            list(APPEND forward "${variable}")
        endif()
    endforeach()
    list(REMOVE_DUPLICATES forward)
    if(EXISTS "${test_rules}")
        set(MCUHW_WORKSPACE OFF)
        set(MCUHW_ACTIVE_BOARDS "")
        set(MCUHW_EXAMPLE "")
        set(MCUHW_BOARD_TESTS "${MCUHW_BOARD}")
        foreach(flag IN ITEMS BUILD_TESTS BUILD_PROBES CHECK_HEADERS BUILD_MCUIP_CONTRACTS
                BUILD_TOOLING_TESTS BUILD_IO_EXAMPLES BUILD_IO_COST_REPORT INSTALL)
            set(MCUHW_${flag} OFF)
            list(APPEND forward MCUHW_${flag})
        endforeach()
        mcuhw_write_initial_cache("${seed}" ${forward} CMAKE_TOOLCHAIN_FILE
            MCUHW_ARM_CXX_COMPILER MCUHW_ESP32P4_CXX_COMPILER MCUHW_BOARD_REVISION
            MCUHW_WORKSPACE MCUHW_ACTIVE_BOARDS MCUHW_EXAMPLE MCUHW_BOARD_TESTS)
        set(source "${MCUHW_ROOT}")
        set(build_args --target board-tests)
        set(environment "")
    else()
        if(IS_ABSOLUTE "${test_project}" OR test_project MATCHES "(^|/)\\.\\.(/|$)" OR
                NOT EXISTS "${MCUHW_ROOT}/${test_project}/CMakeLists.txt")
            message(FATAL_ERROR "Invalid build.test_project for ${MCUHW_BOARD}: ${test_project}")
        endif()
        # SDK test projects use their own toolchain and ordinary SDK entry point.
        mcuhw_idf_environment(environment)
        list(FILTER forward EXCLUDE REGEX "^CMAKE_(C|CXX|ASM|EXE_LINKER)_FLAGS(_[A-Z0-9_]+)?$")
        mcuhw_prepare_sdk_flags(sdk_flags "${binary}/parent-flags.cmake")
        list(APPEND forward ${sdk_flags})
        set(source "${MCUHW_ROOT}/${test_project}")
        set(SDKCONFIG "${binary}/test/sdkconfig")
        set(SDKCONFIG_DEFAULTS "${source}/sdkconfig.defaults")
        set(IDF_TARGET "${MCUHW_IDF_TARGET}")
        mcuhw_write_initial_cache("${seed}" ${forward} PYTHON IDF_TARGET SDKCONFIG SDKCONFIG_DEFAULTS)
        set(build_args "")
    endif()
    add_custom_target(${test_target}
        COMMAND ${environment} "${CMAKE_COMMAND}" -S "${source}" -B "${binary}/test"
            -G "${CMAKE_GENERATOR}" -C "${seed}"
        COMMAND ${environment} "${CMAKE_COMMAND}" --build "${binary}/test"
            --config "$<CONFIG>" ${build_args}
        USES_TERMINAL VERBATIM)
    set_target_properties(${test_target} PROPERTIES FOLDER "Boards/${MCUHW_BOARD}")
endfunction()

function(_mcuhw_workspace_board selection)
    if(NOT selection MATCHES "^([a-z0-9][a-z0-9_-]*/[a-z0-9][a-z0-9_.-]*)(@([a-z0-9][a-z0-9_.-]*))?$")
        message(FATAL_ERROR "Invalid active board '${selection}'; use vendor/board[@revision].")
    endif()
    set(MCUHW_BOARD "${CMAKE_MATCH_1}")
    set(MCUHW_BOARD_REVISION "${CMAKE_MATCH_3}")
    set(_mcuhw_workspace_board TRUE)
    mcuhw_resolve_board()
    set(architecture "${MCUHW_BOARD_ARCHITECTURE}")
    if(NOT architecture STREQUAL MCUHW_ARCH)
        message(FATAL_ERROR "Active board ${MCUHW_BOARD} requires architecture '${architecture}', but this workspace uses '${MCUHW_ARCH}'. Select the matching configure preset or remove this board from MCUHW_ACTIVE_BOARDS.")
    endif()
    # Full vendor-qualified names stay stable as the active set changes.
    string(REPLACE "/" "." prefix "${MCUHW_BOARD}")
    get_property(registered GLOBAL PROPERTY MCUHW_WORKSPACE_BOARD_PREFIXES)
    if(prefix IN_LIST registered)
        message(FATAL_ERROR "Active board ${MCUHW_BOARD} is listed more than once. Use one revision per board in a workspace.")
    endif()
    set_property(GLOBAL APPEND PROPERTY MCUHW_WORKSPACE_BOARD_PREFIXES "${prefix}")
    set(binary "${CMAKE_BINARY_DIR}/board/${MCUHW_BOARD}/${MCUHW_BOARD_REVISION}")
    set(MCUHW_STARTUP supplied)
    if(MCUHW_BOARD_EXAMPLES)
        add_custom_target(${prefix}.examples)
        set_target_properties(${prefix}.examples PROPERTIES FOLDER "Boards/${MCUHW_BOARD}")
        add_dependencies(examples ${prefix}.examples)
        foreach(entry IN LISTS MCUHW_BOARD_EXAMPLES)
            if(NOT entry MATCHES "^example/([a-zA-Z0-9_.-]+/)*[a-zA-Z0-9_.-]+/CMakeLists\\.txt$" OR
                    entry MATCHES "(^|/)\\.\\.(/|$)" OR NOT EXISTS "${MCUHW_ROOT}/${entry}")
                message(FATAL_ERROR "Invalid example entry '${entry}' for ${MCUHW_BOARD}; expected an existing example/.../CMakeLists.txt.")
            endif()
            get_filename_component(directory "${MCUHW_ROOT}/${entry}" DIRECTORY)
            get_filename_component(example "${directory}" NAME)
            set(MCUHW_FIRMWARE_TARGET "${prefix}.examples.${example}")
            if(TARGET ${MCUHW_FIRMWARE_TARGET})
                message(FATAL_ERROR "Duplicate workspace example target ${MCUHW_FIRMWARE_TARGET}")
            endif()
            add_subdirectory("${directory}" "${binary}/example/${example}" EXCLUDE_FROM_ALL)
            if(NOT TARGET ${MCUHW_FIRMWARE_TARGET})
                message(FATAL_ERROR "${entry} must create the requested MCUHW_FIRMWARE_TARGET (${MCUHW_FIRMWARE_TARGET}).")
            endif()
            set_target_properties(${MCUHW_FIRMWARE_TARGET} PROPERTIES
                FOLDER "Boards/${MCUHW_BOARD}/Examples")
            add_dependencies(${prefix}.examples ${MCUHW_FIRMWARE_TARGET})
        endforeach()
    endif()
    _mcuhw_workspace_tests("${prefix}" "${binary}")
endfunction()

function(mcuhw_add_active_boards)
    if(NOT CMAKE_CROSSCOMPILING)
        message(FATAL_ERROR "An active-board workspace requires a cross-architecture configure preset.")
    endif()
    get_filename_component(compiler "${CMAKE_CXX_COMPILER}" REALPATH)
    set(identity "${MCUHW_ARCH}|${compiler}")
    if(DEFINED MCUHW_WORKSPACE_IDENTITY AND NOT MCUHW_WORKSPACE_IDENTITY STREQUAL identity)
        message(FATAL_ERROR "This workspace uses ${MCUHW_WORKSPACE_IDENTITY}; select a separate build directory for ${identity}.")
    endif()
    set(MCUHW_WORKSPACE_IDENTITY "${identity}" CACHE INTERNAL "Workspace architecture/compiler")
    if(NOT MCUHW_ROOT)
        get_filename_component(MCUHW_ROOT "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/.." ABSOLUTE)
    endif()
    set(active "${MCUHW_ACTIVE_BOARDS}")
    if(active STREQUAL "all")
        set(active "")
        file(GLOB entries CONFIGURE_DEPENDS "${MCUHW_ROOT}/board/*/*/board.cmake")
        foreach(entry IN LISTS entries)
            get_filename_component(directory "${entry}" DIRECTORY)
            get_filename_component(name "${directory}" NAME)
            get_filename_component(vendor_directory "${directory}" DIRECTORY)
            get_filename_component(vendor "${vendor_directory}" NAME)
            include("${entry}")
            if(MCUHW_BOARD_ARCHITECTURE STREQUAL MCUHW_ARCH)
                list(APPEND active "${vendor}/${name}")
            endif()
        endforeach()
    endif()
    add_custom_target(examples)
    set_target_properties(examples PROPERTIES FOLDER "Workspace")
    foreach(selection IN LISTS active)
        _mcuhw_workspace_board("${selection}")
    endforeach()
    if(NOT active)
        message(STATUS "No active boards. Set MCUHW_ACTIVE_BOARDS to vendor/board IDs separated by semicolons, then reconfigure.")
    else()
        message(STATUS "Active boards (${MCUHW_ARCH}): ${active}")
    endif()
endfunction()

# A single visible cache selection provides the same task names for every board.
# Child test configurations keep coverage dependencies out of firmware builds.
function(mcuhw_add_selected_board)
    if(NOT CMAKE_CROSSCOMPILING)
        message(FATAL_ERROR "MCUHW_BOARD requires a cross-architecture toolchain. Select the matching architecture preset.")
    endif()
    # Repository board selection is reconfigurable; external applications keep
    # their immutable board contract in McuhwSelection.cmake.
    set(_mcuhw_workspace_board TRUE)
    mcuhw_load_board()
    message(STATUS "Selected board: ${MCUHW_BOARD}@${MCUHW_BOARD_REVISION} (${MCUHW_ARCH})")
    if(MCUHW_BOARD_EXAMPLES)
        set(selected "${MCUHW_EXAMPLE}")
        if(NOT selected)
            set(selected blink)
        endif()
        set(selected_entry "example/app/${selected}/CMakeLists.txt")
        set(entries "")
        list(APPEND entries ${MCUHW_BOARD_EXAMPLES})
        foreach(example IN LISTS MCUHW_BOARD_IO_EXAMPLES)
            list(APPEND entries "example/io/${example}.cpp")
        endforeach()
        if(NOT selected_entry IN_LIST entries)
            message(FATAL_ERROR "MCUHW_EXAMPLE '${selected}' is not a declared application for ${MCUHW_BOARD}.")
        endif()
        set(MCUHW_STARTUP supplied)
        set(MCUHW_FIRMWARE_TARGET firmware)
        add_subdirectory("${MCUHW_ROOT}/example/app/${selected}" application)
        set_target_properties(firmware PROPERTIES FOLDER "Board/${MCUHW_BOARD}")

        add_custom_target(examples)
        set_target_properties(examples PROPERTIES FOLDER "Board/${MCUHW_BOARD}")
        foreach(entry IN LISTS entries)
            if(entry MATCHES "^example/io/([a-z0-9_]+)\\.cpp$")
                set(MCUHW_IO_EXAMPLE "${CMAKE_MATCH_1}")
                set(MCUHW_FIRMWARE_TARGET "example.io.${MCUHW_IO_EXAMPLE}")
                add_subdirectory("${MCUHW_ROOT}/example/io" "example/io/${MCUHW_IO_EXAMPLE}" EXCLUDE_FROM_ALL)
                set_target_properties(${MCUHW_FIRMWARE_TARGET} PROPERTIES FOLDER "Board/${MCUHW_BOARD}/Examples/IO")
                add_dependencies(examples ${MCUHW_FIRMWARE_TARGET})
                continue()
            endif()
            if(NOT entry MATCHES "^example/([a-zA-Z0-9_.-]+/)*[a-zA-Z0-9_.-]+/CMakeLists\\.txt$" OR
                    entry MATCHES "(^|/)\\.\\.(/|$)" OR NOT EXISTS "${MCUHW_ROOT}/${entry}")
                message(FATAL_ERROR "Invalid example entry '${entry}' for ${MCUHW_BOARD}.")
            endif()
            get_filename_component(directory "${MCUHW_ROOT}/${entry}" DIRECTORY)
            get_filename_component(example "${directory}" NAME)
            set(MCUHW_FIRMWARE_TARGET "example.app.${example}")
            if(example STREQUAL selected)
                add_custom_target(${MCUHW_FIRMWARE_TARGET})
                add_dependencies(${MCUHW_FIRMWARE_TARGET} firmware)
            else()
                add_subdirectory("${directory}" "example/${example}" EXCLUDE_FROM_ALL)
            endif()
            set_target_properties(${MCUHW_FIRMWARE_TARGET} PROPERTIES FOLDER "Board/${MCUHW_BOARD}/Examples/Applications")
            add_dependencies(examples ${MCUHW_FIRMWARE_TARGET})
        endforeach()
    elseif(MCUHW_EXAMPLE)
        message(FATAL_ERROR "MCUHW_EXAMPLE '${MCUHW_EXAMPLE}' is not a declared application for ${MCUHW_BOARD}.")
    endif()
    set(binary "${CMAKE_BINARY_DIR}/board/${MCUHW_BOARD}/${MCUHW_BOARD_REVISION}")
    add_custom_target(tests)
    _mcuhw_workspace_tests("board" "${binary}" test.board)
    if(NOT TARGET test.board)
        add_custom_target(test.board
            COMMAND "${CMAKE_COMMAND}" -E echo "Board ${MCUHW_BOARD} has no physical-test recipe."
            COMMAND "${CMAKE_COMMAND}" -E false
            VERBATIM)
    endif()
    set_target_properties(test.board PROPERTIES FOLDER "Board/${MCUHW_BOARD}/Tests")
    add_dependencies(tests test.board)
    include("${CMAKE_CURRENT_FUNCTION_LIST_DIR}/McuhwBoardNativeTests.cmake")
    mcuhw_add_board_native_tests()
    set_target_properties(tests PROPERTIES FOLDER "Board/${MCUHW_BOARD}")
endfunction()
