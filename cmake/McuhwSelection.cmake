# Resolve one board directly; ordinary configuration never enumerates the catalog.
include_guard(GLOBAL)

# @req REQ-0048 REQ-0049
function(mcuhw_resolve_board)
    if(NOT MCUHW_ROOT)
        get_filename_component(MCUHW_ROOT "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/.." ABSOLUTE)
    endif()
    set(MCUHW_ROOT "${MCUHW_ROOT}" CACHE PATH "mcuhw source or installed resource root")
    if(NOT MCUHW_BOARD MATCHES "^[a-z0-9][a-z0-9_-]*/[a-z0-9][a-z0-9_.-]*$")
        message(FATAL_ERROR "Set MCUHW_BOARD to an exact vendor/name ID (for example arduino/uno_r4_minima).")
    endif()
    set(manifest "${MCUHW_ROOT}/board/${MCUHW_BOARD}/component.json")
    if(NOT EXISTS "${manifest}")
        message(FATAL_ERROR "Unknown mcuhw board '${MCUHW_BOARD}': ${manifest} does not exist. Run tools/mcuhw.py list boards.")
    endif()
    file(READ "${manifest}" json)
    if(NOT CMAKE_SCRIPT_MODE_FILE)
        set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${manifest}")
    endif()
    string(JSON version GET "${json}" schema_version)
    string(JSON kind GET "${json}" kind)
    string(JSON id GET "${json}" id)
    if(NOT version EQUAL 2 OR NOT kind STREQUAL "board" OR NOT id STREQUAL MCUHW_BOARD)
        message(FATAL_ERROR "Invalid board identity/schema in ${manifest}; schema version 2 with authoritative build.profile_header/profile_type is required. Migrate the board manifest and validate the catalog.")
    endif()
    if(NOT MCUHW_BOARD_REVISION)
        string(JSON MCUHW_BOARD_REVISION GET "${json}" default_revision)
    endif()
    string(JSON count LENGTH "${json}" revisions)
    set(found FALSE)
    set(supported "")
    math(EXPR last "${count} - 1")
    foreach(index RANGE 0 ${last})
        string(JSON revision GET "${json}" revisions ${index})
        list(APPEND supported "${revision}")
        if(revision STREQUAL MCUHW_BOARD_REVISION)
            set(found TRUE)
        endif()
    endforeach()
    if(NOT found)
        message(FATAL_ERROR "Unsupported revision '${MCUHW_BOARD_REVISION}' for ${MCUHW_BOARD}; supported: ${supported}.")
    endif()
    set(selection "${MCUHW_BOARD}@${MCUHW_BOARD_REVISION}")
    # A repository workspace resolves each board in its own function/directory
    # scope. External applications retain the immutable single-board cache.
    if(NOT _mcuhw_workspace_board)
        if(DEFINED MCUHW_CONFIGURED_BOARD AND NOT MCUHW_CONFIGURED_BOARD STREQUAL selection)
            message(FATAL_ERROR "This build directory belongs to ${MCUHW_CONFIGURED_BOARD}. Use a separate build directory for ${selection}.")
        endif()
        set(MCUHW_CONFIGURED_BOARD "${selection}" CACHE INTERNAL "Immutable board selection")
        set(MCUHW_BOARD "${MCUHW_BOARD}" CACHE STRING "Selected board vendor/name")
        set(MCUHW_BOARD_REVISION "${MCUHW_BOARD_REVISION}" CACHE STRING "Selected board revision")
    endif()
    set(MCUHW_BOARD_REVISION "${MCUHW_BOARD_REVISION}" PARENT_SCOPE)
    foreach(field IN ITEMS toolchain entry)
        string(JSON value GET "${json}" build ${field})
        if(IS_ABSOLUTE "${value}" OR value MATCHES "(^|/)\\.\\.(/|$)" OR NOT EXISTS "${MCUHW_ROOT}/${value}")
            message(FATAL_ERROR "Invalid build.${field} '${value}' in ${manifest}.")
        endif()
        string(TOUPPER "${field}" field_upper)
        set(MCUHW_BOARD_${field_upper} "${MCUHW_ROOT}/${value}" PARENT_SCOPE)
    endforeach()
    string(JSON architecture GET "${json}" build architecture)
    string(JSON profile_header GET "${json}" build profile_header)
    string(JSON profile_type GET "${json}" build profile_type)
    if(NOT profile_header MATCHES "^include/mcuhw/[a-zA-Z0-9_/.-]+\\.hpp$" OR
            profile_header MATCHES "(^|/)\\.\\.(/|$)" OR
            NOT EXISTS "${MCUHW_ROOT}/${profile_header}")
        message(FATAL_ERROR "Invalid build.profile_header '${profile_header}' in ${manifest}.")
    endif()
    if(NOT profile_type MATCHES "^mcuhw::[a-zA-Z_][a-zA-Z0-9_:]*$")
        message(FATAL_ERROR "Invalid build.profile_type '${profile_type}' in ${manifest}.")
    endif()
    string(REGEX REPLACE "^include/" "" profile_header "${profile_header}")
    set(MCUHW_BOARD_ARCHITECTURE "${architecture}" PARENT_SCOPE)
    set(MCUHW_BOARD_PROFILE_HEADER "${profile_header}" PARENT_SCOPE)
    set(MCUHW_BOARD_PROFILE "${profile_type}" PARENT_SCOPE)
    set(MCUHW_BOARD_MANIFEST "${manifest}" PARENT_SCOPE)
endfunction()
