# @req REQ-0049 REQ-0052
# A failed producer must not leave a previous completed record usable.
file(REMOVE "${FIRMWARE}.build.json")
if(NOT EXISTS "${FIRMWARE}")
    message(FATAL_ERROR "Missing linked firmware: ${FIRMWARE}")
endif()
file(SHA256 "${FIRMWARE}" digest)
file(SIZE "${FIRMWARE}" bytes)
# JSON escaping is delegated to CMake's JSON writer for arbitrary host paths.
set(report "{}")
foreach(key IN ITEMS board revision startup compiler artifact sha256)
    if(key STREQUAL artifact)
        set(value "${FIRMWARE}")
    elseif(key STREQUAL sha256)
        set(value "${digest}")
    else()
        set(value "${${key}}")
    endif()
    string(REPLACE "\\" "\\\\" value "${value}")
    string(REPLACE "\"" "\\\"" value "${value}")
    string(JSON report SET "${report}" "${key}" "\"${value}\"")
endforeach()
string(JSON report SET "${report}" bytes "${bytes}")
if(generator STREQUAL "Ninja")
    file(RELATIVE_PATH selected_target "${build_root}" "${FIRMWARE}")
    set(input_build "${build_root}")
    if(sdk_build)
        set(input_build "${sdk_build}")
        get_filename_component(selected_target "${FIRMWARE}" NAME)
        set(sdk_argument --sdk)
    endif()
    execute_process(COMMAND "${python}" "${framework_root}/tool/firmware-inputs.py"
        --ninja "${ninja}" --build "${input_build}" --target "${selected_target}"
        --compiler "${compiler}" --source-root "${source_root}" --framework-root "${framework_root}"
        --output "${FIRMWARE}.inputs.json" --board "${board}" --revision "${revision}"
        --startup "${startup}" ${sdk_argument}
        RESULT_VARIABLE input_result OUTPUT_VARIABLE input_metadata ERROR_VARIABLE input_error)
    if(NOT input_result EQUAL 0)
        message(FATAL_ERROR "Cannot record selected firmware inputs: ${input_error}")
    endif()
    string(JSON report SET "${report}" inputs "${input_metadata}")
else()
    string(JSON report SET "${report}" inputs
        "{\"status\":\"unavailable\",\"reason\":\"selected-input tracking requires the Ninja generator\"}")
endif()
if(sdk_build)
    set(manifest "${sdk_build}/flasher_args.json")
    if(NOT EXISTS "${manifest}")
        message(FATAL_ERROR "Missing SDK flash bundle: ${manifest}")
    endif()
    file(SHA256 "${manifest}" manifest_digest)
    string(JSON report SET "${report}" flash_manifest_sha256 "\"${manifest_digest}\"")
    file(READ "${manifest}" sdk_json)
    string(JSON count LENGTH "${sdk_json}" flash_files)
    math(EXPR last "${count} - 1")
    set(files "{}")
    foreach(index RANGE 0 ${last})
        string(JSON offset MEMBER "${sdk_json}" flash_files ${index})
        string(JSON image GET "${sdk_json}" flash_files "${offset}")
        file(SHA256 "${sdk_build}/${image}" image_digest)
        string(REPLACE "\\" "\\\\" image_json "${image}")
        string(REPLACE "\"" "\\\"" image_json "${image_json}")
        string(JSON files SET "${files}" "${offset}"
            "{\"file\":\"${image_json}\",\"sha256\":\"${image_digest}\"}")
    endforeach()
    string(JSON report SET "${report}" flash_files "${files}")
endif()
file(WRITE "${FIRMWARE}.build.json.tmp" "${report}\n")
file(RENAME "${FIRMWARE}.build.json.tmp" "${FIRMWARE}.build.json")
