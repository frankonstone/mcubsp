include_guard(GLOBAL)
get_filename_component(MCUBSP_ROOT "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)
# Shared by repository presets and external consumers of the installed package.
# @req REQ-0047 REQ-0049
function(mcubsp_add_firmware target)
    # Functions exported from add_subdirectory run in the caller's scope.
    get_filename_component(MCUBSP_ROOT "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/.." ABSOLUTE)
    cmake_parse_arguments(ARG "HOSTED" "BOARD;REVISION;STARTUP" "SOURCES" ${ARGN})
    if(ARG_UNPARSED_ARGUMENTS OR ARG_KEYWORDS_MISSING_VALUES)
        message(FATAL_ERROR "Invalid mcubsp_add_firmware arguments: ${ARG_UNPARSED_ARGUMENTS}; missing values: ${ARG_KEYWORDS_MISSING_VALUES}")
    endif()
    if(NOT ARG_BOARD)
        set(ARG_BOARD "${MCUBSP_BOARD}")
    endif()
    if(NOT ARG_BOARD MATCHES "^[a-z0-9_-]+/[a-z0-9_-]+$")
        message(FATAL_ERROR "mcubsp_add_firmware requires BOARD vendor/name")
    endif()
    set(entry "${MCUBSP_ROOT}/src/board/${ARG_BOARD}/board.cmake")
    if(NOT EXISTS "${entry}")
        message(FATAL_ERROR "Unknown mcubsp board: ${ARG_BOARD}")
    endif()
    include("${entry}")
    if(NOT MCUBSP_ARCH STREQUAL MCUBSP_BOARD_ARCHITECTURE)
        message(FATAL_ERROR "${ARG_BOARD} requires ${MCUBSP_BOARD_ARCHITECTURE}. Configure a fresh build with -DCMAKE_TOOLCHAIN_FILE=${MCUBSP_ROOT}/cmake/board-toolchain.cmake -DMCUBSP_BOARD=${ARG_BOARD} before project(), or supply its matching BSP toolchain.")
    endif()
    if(NOT ARG_REVISION)
        if(ARG_BOARD STREQUAL MCUBSP_BOARD AND MCUBSP_BOARD_REVISION)
            set(ARG_REVISION "${MCUBSP_BOARD_REVISION}")
        else()
            set(ARG_REVISION "${MCUBSP_BOARD_DEFAULT_REVISION}")
        endif()
    endif()
    if(NOT ARG_REVISION IN_LIST MCUBSP_BOARD_REVISIONS)
        message(FATAL_ERROR "Unsupported ${ARG_BOARD} revision: ${ARG_REVISION}; supported: ${MCUBSP_BOARD_REVISIONS}")
    endif()
    if(NOT ARG_STARTUP MATCHES "^(supplied|external)$")
        message(FATAL_ERROR "Select STARTUP supplied or external explicitly")
    endif()
    if(NOT ARG_SOURCES)
        message(FATAL_ERROR "mcubsp_add_firmware requires SOURCES")
    endif()
    if(MCUBSP_ARCH MATCHES "^cortex-m" AND ARG_STARTUP STREQUAL "supplied")
        get_property(enabled_languages GLOBAL PROPERTY ENABLED_LANGUAGES)
        if(NOT "ASM" IN_LIST enabled_languages)
            message(FATAL_ERROR "Supplied Arm startup needs project(... LANGUAGES CXX ASM)")
        endif()
    endif()
    if(MCUBSP_BOARD_SDK AND ARG_STARTUP STREQUAL "supplied")
        include("${MCUBSP_ROOT}/cmake/esp-idf/EspIdf.cmake")
        mcubsp_add_idf_firmware(${target} ${ARG_SOURCES})
        return()
    endif()
    add_executable(${target} ${ARG_SOURCES})
    target_link_libraries(${target} PRIVATE mcubsp::io)
    target_compile_options(${target} PRIVATE ${MCUBSP_ARCH_COMPILE_OPTIONS}
        -Os -ffunction-sections -fdata-sections
        -fno-exceptions -fno-rtti -fno-threadsafe-statics -fno-use-cxa-atexit)
    if(NOT ARG_HOSTED)
        target_compile_options(${target} PRIVATE -ffreestanding)
    endif()
    target_link_options(${target} PRIVATE ${MCUBSP_ARCH_COMPILE_OPTIONS})
    set_target_properties(${target} PROPERTIES SUFFIX ".elf")
    target_link_options(${target} PRIVATE "LINKER:--dependency-file,$<TARGET_FILE:${target}>.link.d")
    set_property(TARGET ${target} APPEND PROPERTY LINK_DEPENDS
        "${MCUBSP_ROOT}/cmake/FirmwareArtifact.cmake" "${MCUBSP_ROOT}/tool/firmware-inputs.py")
    if(ARG_STARTUP STREQUAL "supplied")
        target_sources(${target} PRIVATE ${MCUBSP_BOARD_STARTUP})
        target_link_options(${target} PRIVATE "-T${MCUBSP_BOARD_LINKER}"
            -Wl,--gc-sections -nostartfiles -specs=nano.specs -specs=nosys.specs)
        set_property(TARGET ${target} APPEND PROPERTY LINK_DEPENDS "${MCUBSP_BOARD_LINKER}")
    else()
        target_compile_definitions(${target} PRIVATE MCUBSP_EXTERNAL_STARTUP=1)
    endif()
    if(CMAKE_GENERATOR STREQUAL "Ninja")
        find_package(Python3 3.10 REQUIRED COMPONENTS Interpreter)
    endif()
    add_custom_command(TARGET ${target} POST_BUILD COMMAND "${CMAKE_COMMAND}"
        "-DFIRMWARE=$<TARGET_FILE:${target}>" "-Dboard=${ARG_BOARD}"
        "-Drevision=${ARG_REVISION}" "-Dstartup=${ARG_STARTUP}"
        "-Dcompiler=${CMAKE_CXX_COMPILER}"
        "-Dgenerator=${CMAKE_GENERATOR}" "-Dbuild_root=${CMAKE_BINARY_DIR}"
        "-Dsource_root=${CMAKE_SOURCE_DIR}" "-Dframework_root=${MCUBSP_ROOT}"
        "-Dninja=${CMAKE_MAKE_PROGRAM}" "-Dpython=${Python3_EXECUTABLE}"
        -P "${MCUBSP_ROOT}/cmake/FirmwareArtifact.cmake" VERBATIM)
endfunction()
