{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:mcuhw:catalog:2",
  "title": "mcuhw component manifest version 2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "id",
    "name",
    "summary",
    "category",
    "revisions",
    "default_revision",
    "depends",
    "provides",
    "requires",
    "capability_sources",
    "ownership",
    "evidence",
    "limitations",
    "headers",
    "sources",
    "tests",
    "docs",
    "examples"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 2
    },
    "kind": {
      "type": "string",
      "enum": [
        "board",
        "device",
        "mcu",
        "ip"
      ]
    },
    "id": {
      "type": "string",
      "pattern": "[a-z0-9][a-z0-9_-]*/[a-z0-9][a-z0-9_.-]*"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "category": {
      "type": "string",
      "minLength": 1
    },
    "revisions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "[a-z0-9][a-z0-9_.-]*"
      }
    },
    "default_revision": {
      "type": "string",
      "minLength": 1
    },
    "depends": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "(board|device|ip|mcu):[a-z0-9][a-z0-9_-]*/[a-z0-9][a-z0-9_.-]*(@[a-z0-9][a-z0-9_.-]*)?"
      }
    },
    "provides": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "[a-z][a-z0-9_.:-]*"
      },
      "uniqueItems": true
    },
    "requires": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "[a-z][a-z0-9_.:-]*"
      },
      "uniqueItems": true
    },
    "described": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "[a-z][a-z0-9_.:-]*"
      },
      "uniqueItems": true
    },
    "capability_sources": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "path",
          "contains"
        ],
        "additionalProperties": false,
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "contains": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "ownership": {
      "type": "object",
      "required": [
        "maintainers"
      ],
      "additionalProperties": false,
      "properties": {
        "maintainers": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true,
          "minItems": 1
        }
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "stage",
          "state",
          "scope",
          "revision"
        ],
        "additionalProperties": false,
        "properties": {
          "stage": {
            "enum": [
              "host-test",
              "cross-build",
              "physical"
            ]
          },
          "state": {
            "enum": [
              "passed",
              "failed",
              "stale",
              "missing"
            ]
          },
          "scope": {
            "type": "string",
            "minLength": 1
          },
          "revision": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "[0-9a-f]{64}"
          }
        }
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "variants": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "family",
          "part",
          "package",
          "silicon",
          "source"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "family": {
            "type": "string",
            "minLength": 1
          },
          "part": {
            "type": "string",
            "minLength": 1
          },
          "package": {
            "type": "string",
            "minLength": 1
          },
          "silicon": {
            "type": "string",
            "minLength": 1
          },
          "source": {
            "type": "object",
            "required": [
              "path",
              "contains"
            ],
            "additionalProperties": false,
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "contains": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    "build": {
      "type": "object",
      "properties": {
        "entry": {
          "type": "string",
          "minLength": 1
        },
        "cmake": {
          "type": "string",
          "minLength": 1
        },
        "toolchain": {
          "type": "string",
          "minLength": 1
        },
        "profile_header": {
          "type": "string",
          "minLength": 1
        },
        "profile_type": {
          "type": "string",
          "pattern": "[A-Za-z_][A-Za-z0-9_]*(::[A-Za-z_][A-Za-z0-9_]*)+"
        },
        "tools": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "runner": {
          "type": "object",
          "required": [
            "type",
            "tool",
            "flash_regions",
            "recovery_doc"
          ],
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "jlink",
                "openocd",
                "esp-idf"
              ]
            },
            "tool": {
              "type": "string",
              "minLength": 1
            },
            "recovery_doc": {
              "type": "string",
              "minLength": 1
            },
            "device": {
              "type": "string",
              "minLength": 1
            },
            "interface": {
              "type": "string",
              "minLength": 1
            },
            "target": {
              "type": "string",
              "minLength": 1
            },
            "chip": {
              "type": "string",
              "minLength": 1
            },
            "artifact": {
              "type": "string",
              "minLength": 1
            },
            "build_dir": {
              "type": "string",
              "minLength": 1
            },
            "speed_khz": {
              "type": "integer"
            },
            "flash_regions": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "required": [
                  "start",
                  "size"
                ],
                "additionalProperties": false,
                "properties": {
                  "start": {
                    "type": "string",
                    "pattern": "(0[xX][0-9a-fA-F]+|[0-9]+)"
                  },
                  "size": {
                    "type": "string",
                    "pattern": "(0[xX][0-9a-fA-F]+|[0-9]+)"
                  }
                }
              }
            }
          },
          "additionalProperties": false
        },
        "architecture": {
          "type": "string",
          "pattern": "[a-z0-9][a-z0-9_-]*"
        },
        "test_project": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "headers": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "tests": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "docs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "examples": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    }
  }
}
