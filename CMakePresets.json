{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 25,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "macos",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/macos",
      "toolchainFile": "${sourceDir}/cmake/toolchain-macos.cmake",
      "cacheVariables": {
        "MCUBSP_BUILD_HOST_TESTS": "ON",
        "MCUBSP_BUILD_MCUIP_CONTRACTS": "ON"
      }
    },
    {
      "name": "linux-x86_64",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/linux-x86_64",
      "toolchainFile": "${sourceDir}/cmake/toolchain-linux-x86_64.cmake",
      "cacheVariables": {
        "MCUBSP_BUILD_HOST_TESTS": "ON",
        "MCUBSP_BUILD_MCUIP_CONTRACTS": "ON"
      }
    },
    {
      "name": "arduino-uno-r4-minima",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/arduino-uno-r4-minima",
      "toolchainFile": "${sourceDir}/cmake/toolchain-arm-cortex-m4.cmake",
      "cacheVariables": {
        "MCUBSP_BOARD": { "type": "STRING", "value": "arduino/uno_r4_minima" }
      }
    },
    {
      "name": "st-nucleo-h753zi",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/st-nucleo-h753zi",
      "toolchainFile": "${sourceDir}/cmake/toolchain-arm-cortex-m7.cmake",
      "cacheVariables": {
        "MCUBSP_BOARD": { "type": "STRING", "value": "st/nucleo_h753zi" }
      }
    },
    {
      "name": "waveshare-esp32p4-nano",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/waveshare-esp32p4-nano",
      "toolchainFile": "${sourceDir}/cmake/toolchain-esp32p4.cmake",
      "cacheVariables": {
        "MCUBSP_BOARD": { "type": "STRING", "value": "waveshare/esp32p4_nano" }
      }
    }
  ],
  "buildPresets": [
    { "name": "macos", "configurePreset": "macos" },
    { "name": "linux-x86_64", "configurePreset": "linux-x86_64" },
    { "name": "arduino-uno-r4-minima", "configurePreset": "arduino-uno-r4-minima" },
    { "name": "st-nucleo-h753zi", "configurePreset": "st-nucleo-h753zi" },
    { "name": "waveshare-esp32p4-nano", "configurePreset": "waveshare-esp32p4-nano" }
  ]
}
