{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 25,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "macos-arm64",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/output/build/macos-arm64",
      "toolchainFile": "${sourceDir}/cmake/toolchain-macos-arm64.cmake",
      "cacheVariables": {
        "MCUBSP_BUILD_HOST_TESTS": "ON",
        "MCUBSP_CHECK_HEADERS": "ON"
      }
    },
    {
      "name": "linux-x86_64",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/output/build/linux-x86_64",
      "toolchainFile": "${sourceDir}/cmake/toolchain-linux-x86_64.cmake",
      "cacheVariables": {
        "MCUBSP_BUILD_HOST_TESTS": "ON",
        "MCUBSP_CHECK_HEADERS": "ON"
      }
    },
    {
      "name": "arduino-uno-r4-minima",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/output/build/arduino-uno-r4-minima",
      "toolchainFile": "${sourceDir}/cmake/toolchain-arm-cortex-m4.cmake",
      "cacheVariables": {
        "MCUBSP_BOARD": {
          "type": "STRING",
          "value": "arduino/uno_r4_minima"
        }
      }
    },
    {
      "name": "st-nucleo-h753zi",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/output/build/st-nucleo-h753zi",
      "toolchainFile": "${sourceDir}/cmake/toolchain-arm-cortex-m7.cmake",
      "cacheVariables": {
        "MCUBSP_BOARD": {
          "type": "STRING",
          "value": "st/nucleo_h753zi"
        }
      }
    },
    {
      "name": "promicro-nrf52840",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/output/build/promicro-nrf52840",
      "toolchainFile": "${sourceDir}/cmake/board-toolchain.cmake",
      "cacheVariables": {
        "MCUBSP_BOARD": "others/promicro_nrf52840"
      }
    },
    {
      "name": "waveshare-esp32p4-nano",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/output/build/waveshare-esp32p4-nano",
      "toolchainFile": "${sourceDir}/cmake/toolchain-esp32p4.cmake",
      "cacheVariables": {
        "MCUBSP_BOARD": {
          "type": "STRING",
          "value": "waveshare/esp32p4_nano"
        }
      }
    }
  ],
  "buildPresets": [
    {
      "name": "macos-arm64",
      "configurePreset": "macos-arm64"
    },
    {
      "name": "linux-x86_64",
      "configurePreset": "linux-x86_64"
    },
    {
      "name": "arduino-uno-r4-minima",
      "configurePreset": "arduino-uno-r4-minima"
    },
    {
      "name": "st-nucleo-h753zi",
      "configurePreset": "st-nucleo-h753zi"
    },
    {
      "name": "waveshare-esp32p4-nano",
      "configurePreset": "waveshare-esp32p4-nano"
    },
    {
      "name": "promicro-nrf52840",
      "configurePreset": "promicro-nrf52840"
    }
  ],
  "testPresets": [
    {
      "name": "macos-arm64",
      "configurePreset": "macos-arm64",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "linux-x86_64",
      "configurePreset": "linux-x86_64",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
