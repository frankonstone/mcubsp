{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 25,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "native",
      "displayName": "Native",
      "inherits": "base",
      "binaryDir": "${sourceDir}/build/native",
      "cacheVariables": {
        "MCUHW_ARCH": "native"
      }
    },
    {
      "name": "arm-cortex-m4",
      "displayName": "ARM Cortex-M4",
      "inherits": "base",
      "binaryDir": "${sourceDir}/build/arm-cortex-m4",
      "toolchainFile": "${sourceDir}/cmake/toolchain-arm-cortex-m4.cmake"
    },
    {
      "name": "arm-cortex-m7",
      "displayName": "ARM Cortex-M7",
      "inherits": "base",
      "binaryDir": "${sourceDir}/build/arm-cortex-m7",
      "toolchainFile": "${sourceDir}/cmake/toolchain-arm-cortex-m7.cmake"
    },
    {
      "name": "esp32p4-riscv",
      "displayName": "ESP32-P4 RISC-V",
      "inherits": "base",
      "binaryDir": "${sourceDir}/build/esp32p4-riscv",
      "toolchainFile": "${sourceDir}/cmake/toolchain-esp32p4.cmake"
    }
  ],
  "buildPresets": [
    {
      "name": "native",
      "configurePreset": "native"
    },
    {
      "name": "arm-cortex-m4",
      "configurePreset": "arm-cortex-m4"
    },
    {
      "name": "arm-cortex-m7",
      "configurePreset": "arm-cortex-m7"
    },
    {
      "name": "esp32p4-riscv",
      "configurePreset": "esp32p4-riscv"
    }
  ]
}
